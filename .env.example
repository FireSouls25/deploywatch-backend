# Copia este archivo a .env y rellena los valores. .env no se versiona.

# Opcional: token personal de GitHub (eleva el límite de peticiones).
GITHUB_TOKEN=

# Base de datos de Docker Compose. Usa una contraseña propia y larga.
POSTGRES_USER=deploywatch
POSTGRES_PASSWORD=
POSTGRES_DB=deploywatch

# Fuera de Docker se usa SQLite por defecto.
DATABASE_URL=sqlite:///./deploywatch.db
